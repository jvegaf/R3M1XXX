
(rules PCB freerouting.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute off)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.5)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.5)
    )
  )
  (rule
    (width 304.8)
    (clearance 152.4)
    (clearance 152.4 (type smd_to_turn_gap))
    (clearance 38.2 (type smd))
    (clearance 152.4 (type "kicad_default"))
  )
  (padstack "Via[0-1]_900:500_um"
    (shape
      (circle F.Cu 900.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 900.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_900:500_um" "Via[0-1]_900:500_um" default
  )
  (via 
    "Via[0-1]_900:500_um-kicad_default" "Via[0-1]_900:500_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_900:500_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_900:500_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 304.8)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    +5V /COM0 "Net-(D1-K)" "Net-(D2-K)" /SCL /SDA "Net-(JP1-B)" /A0
    "Net-(JP2-B)" /A1 "Net-(JP3-B)" "Net-(JP4-B)" /COM1 "Net-(D3-K)" /COM2 "/A0_H"
    /POT1 /POT2 /POT3 /POT4 /POT5 /POT6 /POT7 /POT8
    "/A1_H" /R3 /R4 /R5 "unconnected-(U1-COM-Pad11)" "unconnected-(U1-REFin{slash}REFout-Pad10)" /R6 /R2
    /R7 /R8 /R9 /R10 "unconnected-(U2-COM6-Pad8)" "unconnected-(U2-ROW11{slash}K10{slash}INT-Pad10)" "unconnected-(U2-COM3{slash}KS2-Pad5)" "unconnected-(U2-COM7-Pad9)"
    "unconnected-(U2-COM5-Pad7)" "unconnected-(U2-COM4-Pad6)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 304.8)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class GND
    GND
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 406.4)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)